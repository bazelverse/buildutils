load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test", "rust_library")

rust_library(
    name = "wait_utils",
    srcs = glob([
        "src/*.rs",
        "src/*/*.rs",
    ]),
    crate_root = "src/lib.rs",
    # One library target serves every Bazel consumer, so the feature is on here and the gRPC strategy stays built.
    crate_features = ["grpc"],
    tags = [
        "utils-test",
        "wait_utils",
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Internal crates

        # External crates
        "@crates//:tokio",
        "@crates//:tonic",
        "@crates//:tonic-health",
    ],
)

rust_doc(
    name = "doc",
    crate = ":wait_utils",
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc_test",
    crate = ":wait_utils",
    tags = ["doc-test"],
    visibility = ["//visibility:public"],
)
